<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1633"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="AetherSora Logo"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AetherSora"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi 5GHz Lossless Audio (48 kHz PCM)"
                android:textColor="#38BDF8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#15224A"
        android:padding="14dp"
        android:text="Status: Idle — Select a PC on Wi-Fi LAN"
        android:textColor="#FACC15"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Discovered PCs on Wi-Fi LAN"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#1E3A8A"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Scan LAN"
            android:textColor="#F8FAFC"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/listPcs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111C3F"
        android:divider="#1E293B"
        android:dividerHeight="1dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        android:text="Target PC IP Address (UDP 19480)"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/editPcIp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#15224A"
        android:hint="e.g. 192.168.1.50"
        android:inputType="textNoSuggestions"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:singleLine="true"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/chkAutoMute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:buttonTint="#38BDF8"
        android:checked="true"
        android:text="Auto-mute phone speaker (set media volume to 0)"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="#38BDF8"
        android:text="Connect &amp; Stream Lossless"
        android:textColor="#0D1633"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="No Developer Mode or ADB required. Uncheck Auto-mute if your Android ROM silences capture at volume 0. Restores phone volume automatically on Disconnect."
        android:textColor="#64748B"
        android:textSize="11sp" />

</LinearLayout>
